# ─── Racketly — Variables de entorno ─────────────────────────────────────────
# Copiar a .env y completar con los valores reales

# ─── Base de Datos ────────────────────────────────────────────────────────────
# En producción, si la base de datos no está en la misma red privada que los
# servicios (ej. un proveedor cloud gestionado), agregar `?sslmode=require` (o
# `verify-full` si el proveedor entrega un CA) — sin esto, la conexión viaja sin
# cifrar. En local (localhost) no aplica.
DATABASE_URL=postgresql://racketly:racketly_dev_pass@localhost:5432/racketly

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_secret
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_secret
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=change_this_to_a_random_32_byte_base64_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# ─── Mux (Video) ──────────────────────────────────────────────────────────────
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...

# ─── AWS S3 / Cloudflare R2 ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=racketly-media

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ─── Google Maps / Mapbox ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=...
EXPO_PUBLIC_GOOGLE_MAPS_KEY=...

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
TOURNAMENT_SERVICE_URL=http://localhost:3003
COMMUNITY_SERVICE_URL=http://localhost:3004
ACADEMY_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── Sentry (observabilidad / error tracking) ────────────────────────────────
# Un DSN por proyecto de Sentry — se puede reusar el mismo DSN en los 7 servicios
# backend (todos van al mismo proyecto "racketly-backend", separados por serverName)
# o crear un proyecto por servicio si se prefiere aislar las alertas.
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Solo necesarios para que el build de apps/web suba source maps a Sentry (opcional,
# sin esto el build sigue funcionando, solo sin stack traces desofuscados).
SENTRY_ORG=...
SENTRY_PROJECT=...
SENTRY_AUTH_TOKEN=...

# ─── NODE_ENV ─────────────────────────────────────────────────────────────────
NODE_ENV=development
