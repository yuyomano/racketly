{
  "name": "@racketly/utils",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pii-crypto": {
      "types": "./dist/pii-crypto.d.ts",
      "import": "./dist/pii-crypto.js",
      "require": "./dist/pii-crypto.js",
      "default": "./dist/pii-crypto.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "require": "./dist/observability.js",
      "default": "./dist/observability.js"
    },
    "./prisma-adapter": {
      "types": "./dist/prisma-adapter.d.ts",
      "import": "./dist/prisma-adapter.js",
      "require": "./dist/prisma-adapter.js",
      "default": "./dist/prisma-adapter.js"
    },
    "./s3-media": {
      "types": "./dist/s3-media.d.ts",
      "import": "./dist/s3-media.js",
      "require": "./dist/s3-media.js",
      "default": "./dist/s3-media.js"
    },
    "./plus-code": {
      "types": "./dist/plus-code.d.ts",
      "import": "./dist/plus-code.js",
      "require": "./dist/plus-code.js",
      "default": "./dist/plus-code.js"
    }
  },
  "typesVersions": {
    "*": {
      "pii-crypto": [
        "./dist/pii-crypto.d.ts"
      ],
      "observability": [
        "./dist/observability.d.ts"
      ],
      "prisma-adapter": [
        "./dist/prisma-adapter.d.ts"
      ],
      "s3-media": [
        "./dist/s3-media.d.ts"
      ],
      "plus-code": [
        "./dist/plus-code.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@racketly/shared-types": "*",
    "@sentry/node": "^10.73.0",
    "open-location-code": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "^5.0.0"
  }
}
