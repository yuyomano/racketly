{
  "name": "@racketly/utils",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pii-crypto": {
      "import": "./dist/pii-crypto.js",
      "require": "./dist/pii-crypto.js",
      "types": "./dist/pii-crypto.d.ts"
    },
    "./observability": {
      "import": "./dist/observability.js",
      "require": "./dist/observability.js",
      "types": "./dist/observability.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "pii-crypto": [
        "./dist/pii-crypto.d.ts"
      ],
      "observability": [
        "./dist/observability.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@racketly/shared-types": "*",
    "@sentry/node": "^10.73.0"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "^5.0.0"
  }
}
